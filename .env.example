# 本地运行配置模板：复制为 .env 并填入真实值（.env 已被 gitignore 排除，不会提交）
# cp .env.example .env

# ── 认证（二选一，优先 Cookie）──────────────────────────
# 浏览器复制的完整 Cookie 字符串（获取方法见 README）
# LINUXDO_COOKIES=_t=xxxxx; theme_ids=1; ...

# Cookie 未提供或失效时的回退方式
# LINUXDO_USERNAME=your_username
# LINUXDO_PASSWORD=your_password

# ── 浏览行为 ────────────────────────────────────────────
# 是否执行浏览行为（默认 true；false 时仅登录验证）
# BROWSE_ENABLED=true
# 浏览帖数（1~20，默认 6）
# BROWSE_COUNT=6
# 是否启用点赞（默认 false；开启后概率 ≤30% 且每次运行 ≤3 次）
# LIKE_ENABLED=false
# 是否无头浏览器（默认 true；本地调试可设 false 观察行为）
# HEADLESS=true

# ── 通知（可选）─────────────────────────────────────────
# NOTIFY_ENABLED=false
# NOTIFY_CHANNEL=telegram
# NOTIFY_TELEGRAM_BOT_TOKEN=123456:ABC-xxx
# NOTIFY_TELEGRAM_CHAT_ID=123456789

# ── 其他 ────────────────────────────────────────────────
# 日志级别：DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO
